# MedicaLLM — production environment template.
# Copy to `.env` on the droplet and fill in real values:
#     cp .env.production.example .env
#     chmod 600 .env

# ─── Public URL ──────────────────────────────────────────────────────────────
# Domain that points at the droplet's public IP (an A-record). Used by the
# nginx TLS template AND the CORS allow-list below.
DOMAIN_NAME=medicallm.example.com
LETSENCRYPT_EMAIL=you@example.com

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-strong-random-secret

# Admin panel
ADMIN_USERNAME=medicallm
ADMIN_PASSWORD=replace-with-strong-password

# ─── Database (DigitalOcean Managed Postgres) ────────────────────────────────
DO_POSTGRES_URL=postgresql://USER:PASSWORD@HOST:25060/DBNAME?sslmode=require

# ─── DigitalOcean AI (LLM) ───────────────────────────────────────────────────
DO_MODEL_ACCESS_KEY=
DO_LLM_MODEL_ID=openai-gpt-oss-120b

# ─── Embeddings ──────────────────────────────────────────────────────────────
HF_EMBEDDING_MODEL_ID=nomic-ai/nomic-embed-text-v1
HF_TOKEN=

# ─── External APIs (optional) ────────────────────────────────────────────────
SCOPUS_API_KEY=
NCBI_API_KEY=
OPENALEX_EMAIL=

# ─── SMTP (transactional email) ──────────────────────────────────────────────
# Hostinger:  host=smtp.hostinger.com  port=465  use_ssl=true
# Mailbox you created in Hostinger panel for noreply@your-domain.tr
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=noreply@medicallm.com.tr
SMTP_PASSWORD=replace-with-mailbox-password
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
SMTP_FROM_ADDRESS=noreply@medicallm.com.tr
SMTP_FROM_NAME=MedicaLLM
PUBLIC_APP_URL=https://medicallm.com.tr

# ─── CORS ────────────────────────────────────────────────────────────────────
# Must include https://${DOMAIN_NAME}. Comma-separated list, no spaces.
CORS_ALLOWED_ORIGINS=https://medicallm.example.com

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_NAME=MedicaLLM
