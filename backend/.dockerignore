# Environment files
.env
.env.*

# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# IDE
.vscode/
.idea/

# Git
.git/
.gitignore

# Documentation
README.md
*.md

# Runtime data — these are mounted as volumes at runtime, must NOT be baked
# into the image. Without these excludes the build copies multi-GB of vector
# data and PDFs and "exporting layers" takes 5+ minutes.
data/
chromadb-data/

# Log files (generated at runtime)
logs/
log/
*.log

# Temporary files
*.tmp
*.temp
.DS_Store
