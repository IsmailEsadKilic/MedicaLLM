# JWT secret for authentication
JWT_SECRET=change-me-to-a-random-string

# Digital Ocean AI
DO_MODEL_ACCESS_KEY=
DO_LLM_MODEL_ID=openai-gpt-oss-20b

# Embedding model
HF_EMBEDDING_MODEL_ID=nomic-ai/nomic-embed-text-v1
HF_TOKEN=

# Logging
LOG_LEVEL=INFO
APP_NAME=MedicaLLM

# Scopus API key (optional - for enhanced citation metrics)
# Get your API key from: https://dev.elsevier.com/
SCOPUS_API_KEY=
SCOPUS_USE_FOR_CITATIONS=true

# NCBI / PubMed E-utilities API key (optional but strongly recommended)
# Bumps rate limit from 3 req/sec to 10 req/sec
# Get your free key from: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# OpenAlex (free, used for FWCI). Email enables the "polite pool" for higher rate limits.
OPENALEX_ENABLED=true
OPENALEX_EMAIL=
# Admin panel credentials
ADMIN_USERNAME=medicallm
ADMIN_PASSWORD=sezeristan000

# Cloud Database URL
DO_POSTGRES_URL=